{
  "name": "@klods/docs",
  "version": "0.0.0",
  "description": "Self-generating documentation site for klods.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:visual": "playwright test",
    "test:visual:pr": "playwright test --grep 'default theme'",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "vitest"
  },
  "dependencies": {
    "happy-dom": "20.9.0",
    "highlight.js": "^11.11.1",
    "klods-css": "*",
    "klods-js": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "prettier": "3.8.3",
    "sass": "1.81.0",
    "typescript": "5.6.3",
    "vite": "8.1.0"
  },
  "private": true
}
